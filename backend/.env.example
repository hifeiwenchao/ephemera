# 仅用于直接运行 Python 后端；请填写本机 MySQL 与 Redis 密码。
# 密码中的 @、:、/、#、% 等特殊字符需使用 URL 编码。
DATABASE_URL=mysql://root:replace-with-your-password@127.0.0.1:3306/single_chat
REDIS_URL=redis://default:CHANGE_ME@127.0.0.1:6379/0
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
SESSION_COOKIE_SECURE=false
ALLOW_LEGACY_IDENTITY=false
AUTH_TEST_MODE=false
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=no-reply@local.test
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
HOST=127.0.0.1
PORT=8001
DEBUG=false
CLEANUP_INTERVAL_SECONDS=60
CORS_ORIGINS=http://localhost:5173
