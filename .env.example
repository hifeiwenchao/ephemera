# 用于 Docker Compose；容器通过 host.docker.internal 访问本机 MySQL 与 Redis。
# 请填写实际密码；@、:、/、#、% 等特殊字符需使用 URL 编码。
DATABASE_URL=mysql://root:replace-with-your-password@host.docker.internal:3306/single_chat
REDIS_URL=redis://default:CHANGE_ME@host.docker.internal:6379/0
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
SESSION_COOKIE_SECURE=false
ALLOW_LEGACY_IDENTITY=false
AUTH_TEST_MODE=false
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=no-reply@local.test
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
API_PORT=8001
WEB_PORT=5174
CLEANUP_INTERVAL_SECONDS=60
SMTP_PORT_HOST=1025
MAILPIT_WEB_PORT=8025

# 可选 bundled-db 配置；默认不启动内置 MySQL。
# 使用内置数据库时，将上面的 DATABASE_URL 改为：
# mysql://chat:chat_password@mysql:3306/single_chat
MYSQL_PORT=3307
MYSQL_DATABASE=single_chat
MYSQL_USER=chat
MYSQL_PASSWORD=chat_password
MYSQL_ROOT_PASSWORD=root_password
